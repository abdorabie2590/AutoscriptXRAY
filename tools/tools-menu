#!/bin/bash
# Menu Tools by Eng.Abdelrahman Rabie

# Warna
CYAN='\e[1;38;5;51m'
GREEN='\e[1;38;5;48m'
YELLOW='\e[1;38;5;220m'
NC='\e[0m'

# theme
for _t in /etc/autoscriptvpn/theme.sh /root/AutoscriptXRAY/theme.sh; do
    [[ -f "$_t" ]] && { source "$_t"; break; }
done

clear
theme_banner "MENU TOOLS"
theme_item "1" "Backup & Restore Config"
theme_item "2" "Speedtest VPS"
theme_item "3" "Ganti Domain XRAY"
theme_item "4" "Cek status layanan aktif"
theme_item "x" "Kembali ke menu utama"
theme_footer
read -p "$(echo -e "${GOLD}👉 Pilih opsi: ${NC}")" opt

case $opt in
1) bash /etc/autoscriptvpn/tools/backup.sh ;;
2) bash /etc/autoscriptvpn/tools/speedtest.sh ;;
3) bash /etc/autoscriptvpn/tools/domain.sh ;;
4) bash /etc/autoscriptvpn/tools/running.sh ;;
x) menu ;;
*) echo "❌ Pilihan salah!" ; sleep 1 ; tools-menu ;;
esac
