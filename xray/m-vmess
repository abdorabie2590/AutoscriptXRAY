#!/bin/bash
# VMess menu - by Eng.Abdelrahman Rabie

GREEN='\e[1;38;5;48m'
YELLOW='\e[1;38;5;220m'
CYAN='\e[1;38;5;51m'
NC='\e[0m'

# theme
for _t in /etc/autoscriptvpn/theme.sh /root/AutoscriptXRAY/theme.sh; do
    [[ -f "$_t" ]] && { source "$_t"; break; }
done

clear
theme_banner "MENU VMESS XRAY"
theme_item "1" "Add VMess Account"
theme_item "2" "Delete VMess Account"
theme_item "3" "Check VMess Login"
theme_item "4" "Renew Account"
theme_item "x" "Back to main menu"
theme_footer

read -p "$(echo -e "${GOLD}👉 Select option: ${NC}")" opt

case $opt in
1)
bash /etc/autoscriptvpn/xray/add-vmess.sh
;;

2)
bash /etc/autoscriptvpn/xray/del-vmess.sh
;;

3)
bash /etc/autoscriptvpn/xray/check-vmess.sh
;;

4)
bash /etc/autoscriptvpn/xray/renew-vmess.sh
;;

x)
menu
;;

*)
echo "❌ Invalid option!"
sleep 1
exec m-vmess
;;
esac
