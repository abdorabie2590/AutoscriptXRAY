#!/bin/bash
# Menu VLESS - by Eng.Abdelrahman Rabie

GREEN='\e[1;38;5;48m'
YELLOW='\e[1;38;5;220m'
CYAN='\e[1;38;5;51m'
NC='\e[0m'

# theme
for _t in /etc/autoscriptvpn/theme.sh /root/AutoscriptXRAY/theme.sh; do
    [[ -f "$_t" ]] && { source "$_t"; break; }
done

clear
theme_banner "MENU VLESS XRAY"
theme_item "1" "Tambah Akun VLESS"
theme_item "2" "Hapus Akun VLESS"
theme_item "3" "Cek Login VLESS"
theme_item "4" "Perpanjang Masa Aktif Akun"
theme_item "x" "Kembali ke menu utama"
theme_footer

read -p "$(echo -e "${GOLD}👉 Pilih opsi: ${NC}")" opt

case $opt in
1)
bash /etc/autoscriptvpn/xray/add-vless.sh
;;

2)
bash /etc/autoscriptvpn/xray/del-vless.sh
;;

3)
bash /etc/autoscriptvpn/xray/cek-vless.sh
;;

4)
bash /etc/autoscriptvpn/xray/renew-vless.sh
;;

x)
menu
;;

*)
echo "❌ Pilihan salah!"
sleep 1
m-vless
;;
esac
