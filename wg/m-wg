#!/bin/bash
# WireGuard menu - by Eng.Abdelrahman Rabie

# Colors
GREEN='\e[1;38;5;48m'
YELLOW='\e[1;38;5;220m'
CYAN='\e[1;38;5;51m'
NC='\e[0m'

# theme
for _t in /etc/autoscriptvpn/theme.sh /root/AutoscriptXRAY/theme.sh; do
    [[ -f "$_t" ]] && { source "$_t"; break; }
done

clear
theme_banner "MENU WIREGUARD VPN"
theme_item "1" "Add WireGuard Account"
theme_item "2" "Delete WireGuard Account"
theme_item "3" "View Account Configuration"
theme_item "4" "Check WireGuard Status"
theme_item "5" "Restart WireGuard"
theme_item "x" "Back to main menu"
theme_footer
read -p "$(echo -e "${GOLD}👉 Select option: ${NC}")" opt

case $opt in

1)
clear
bash /etc/autoscriptvpn/wg/wg-add.sh
;;

2)
clear
bash /etc/autoscriptvpn/wg/wg-del.sh
;;

3)
clear
bash /etc/autoscriptvpn/wg/wg-show.sh
;;

4)
clear
wg show
;;

5)
clear
systemctl restart wg-quick@wg0

echo ""
echo "✅ WireGuard direstart!"
echo ""
;;

x)
menu
;;

*)
echo "❌ Invalid option!"
sleep 1
exec m-wg
;;
esac
